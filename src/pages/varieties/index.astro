---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const items = (await getCollection("varieties"))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
---
<BaseLayout title="Varieties" description={`${items.length} rhubarb varieties documented`}>
  <h1>Varieties ({items.length})</h1>
  <ul class="listing">
    {items.map((r) => (
      <li>
        <a href={`${import.meta.env.BASE_URL}varieties/${r.id}/`}>{r.data.title}</a>
        {r.data.description && <span class="desc">{r.data.description}</span>}
      </li>
    ))}
  </ul>
</BaseLayout>
